{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docsdotdev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat provides node:crypto / Buffer, which the admin auth uses.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Set secrets with `wrangler secret put GITHUB_PAT` (and ADMIN_PIN etc.).
  // These vars only power the optional /admin editor's publish flow — point
  // them at YOUR copy of this repo after creating it from the template.
  "vars": {
    "GITHUB_OWNER": "keyboard-dev",
    "GITHUB_REPO": "docs.dev",
    "GITHUB_BRANCH": "main",
    // Team sign-in via docs.dev. Register your site in the docs.dev dashboard
    // (redirect URI: https://<your-host>/api/admin/sso/callback), then paste
    // the Site ID here. Leave empty for standalone PIN auth.
    "DOCSDEV_SITE_ID": "",
    "DOCSDEV_ISSUER": "https://app.docs.dev"
  }
}
